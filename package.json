{
  "name": "bbplayer-desktop",
  "version": "0.1.4",
  "description": "B 站音频播放器桌面端（Windows / macOS / Linux）",
  "main": "./out/main/index.js",
  "author": "BBPlayer",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-transform-types --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "audit": "npm audit --audit-level=high",
    "gen:icon": "node scripts/gen-icon.mjs",
    "build:win": "electron-vite build && electron-builder --win && node scripts/cleanup.mjs",
    "build:mac": "electron-vite build && electron-builder --mac && node scripts/cleanup.mjs",
    "build:linux": "electron-vite build && electron-builder --linux && node scripts/cleanup.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^5.12.0",
    "@tanstack/react-query": "^5.51.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "i18next": "^23.16.8",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.4.4"
  },
  "overrides": {
    "braces": "^3.0.3"
  }
}
